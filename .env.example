# Copia este archivo a `.env` y completa con las llaves de tu proyecto Supabase.
# (Project Settings -> API en el panel de Supabase.)
#
# La anon key es pública por diseño: se puede exponer en el frontend porque los
# datos quedan protegidos por Row Level Security (RLS).

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key
